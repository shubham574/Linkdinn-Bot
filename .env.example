APP_ENV=development

# Postgres in Docker Compose; SQLite fallback works for quick local runs.
DATABASE_URL=sqlite:///./data/dev.db
# DATABASE_URL=postgresql+psycopg://linkedin:linkedin@localhost:5432/linkedin_agent

# Gemini does research + writing + rewriting + fact-checking (Phase 2+)
GEMINI_API_KEY=
GEMINI_MODEL=
TAVILY_API_KEY=

# LinkedIn (Phase 5)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=

# Safety defaults: never publish while developing
DRY_RUN=true
AUTO_PUBLISH=false
MAX_REVISIONS=3

# Post rater (Laya-backed from Phase 3). All thresholds are configurable.
RATER_APPROVAL_THRESHOLD=85
RATER_MIN_PERSONAL_VOICE=50
RATER_MIN_SPECIFICITY=60
RATER_MIN_FACTUAL_CONFIDENCE=80
RATER_MAX_GENERIC_AI_LANGUAGE=40
RATER_MAX_FABRICATION_PROB=0.2

# Comma-separated, configurable
RESEARCH_CATEGORIES=AI,Generative AI,LLMs,AI agents,Agentic workflows,Web development,React,Next.js,Node.js,Backend,APIs,Automation,LangGraph,LangChain,Developer tools,Cloud,Open source

SCHEDULE_TIME=08:00
TIMEZONE=Asia/Kolkata
